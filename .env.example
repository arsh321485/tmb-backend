# Copy this file to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

BACKEND_URL=https://tmb-backend.onrender.com
FRONTEND_URL=http://localhost:5173
FRONTEND_LOGIN_SUCCESS_PATH=/dashboard
FRONTEND_LOGIN_ERROR_PATH=/login
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB
MONGO_HOST=mongodb://localhost:27017
MONGO_DB_NAME=tmb_backend

# Slack app -> https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://tmb-backend.onrender.com/api/auth/slack/callback/
SLACK_SCOPES=openid,email,profile
# files:read + im:history are required for plan intake (B1) to see and
# download files dropped into a DM -- missing these silently breaks
# upload for any newly installed workspace (nothing to show, no error).
#
# users:read.email was previously suspected app-wide broken ("Invalid
# permissions requested" on install), but testing proved it's actually
# a per-workspace admin restriction -- it failed only in the app's own
# home workspace (Securitlab) and worked fine installing into others.
# The code still tolerates its absence either way (falls back to
# identifying installers by Slack user id), so a workspace with a
# similar restriction degrades gracefully rather than failing outright
# -- but if a real client's install fails with that same error, this is
# the scope to suspect and drop first.
SLACK_BOT_SCOPES=channels:history,channels:manage,chat:write,commands,files:read,im:history,users:read,users:read.email
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Azure AD app -> https://portal.azure.com (App registrations)
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=common
TEAMS_REDIRECT_URI=https://tmb-backend.onrender.com/api/auth/teams/callback/
TEAMS_SCOPES=openid email profile User.Read
